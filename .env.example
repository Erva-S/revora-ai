# ====================================================================
# SUPABASE CONFIGURATION (Frontend & Database)
# ====================================================================
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ====================================================================
# AI INTELLIGENCE (Google Gemini API)
# ====================================================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Optional context management (Supabase Edge secrets, never VITE_*):
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768
CONTEXT_TOKEN_BUDGET=7000
ENABLE_TASK_CARRYOVER=false

# ====================================================================
# MEETING BOT INTEGRATION (MeetingBaaS)
# ====================================================================
MEETINGBAAS_API_KEY=your-meetingbaas-api-key-here
MEETINGBAAS_API_BASE_URL=https://api.meetingbaas.com
BOT_NAME=AI Meeting Assistant
BOT_ENTRY_MESSAGE=Hi, I'm an AI assistant here to take notes for this meeting.
SPEECH_TO_TEXT_PROVIDER=gladia
PUBLIC_WEBHOOK_URL=https://your-webhook-url.trycloudflare.com

# Auto-leave (bot lifecycle). MeetingBaaS applies these to every deployed bot.
# The bot leaves on its own when the last human participant has left; these
# values only bound the fallbacks. Ranges are enforced by the MeetingBaaS API,
# so out-of-range values are clamped.
# BOT_WAITING_ROOM_TIMEOUT=300   # 120-1800s: give up waiting to be admitted
# BOT_NO_ONE_JOINED_TIMEOUT=120  # 120-1800s: leave if nobody ever joins
# BOT_SILENCE_TIMEOUT=300        # 300-3600s: leave after this much total silence
# BOT_IGNORED_PARTICIPANT_NAMES= # comma-separated OTHER bot names to ignore
#                                # (never list this bot's own BOT_NAME here)

# ====================================================================
# BACKEND SERVER CONFIGURATION (Express / Node.js)
# ====================================================================
PORT=5000
CORS_ORIGIN=http://localhost:5173
