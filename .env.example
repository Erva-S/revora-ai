# ====================================================================
# SUPABASE CONFIGURATION (Frontend & Database)
# ====================================================================
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ====================================================================
# AI INTELLIGENCE (Google Gemini API)
# ====================================================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Optional context management (Supabase Edge secrets, never VITE_*):
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768
CONTEXT_TOKEN_BUDGET=7000
ENABLE_TASK_CARRYOVER=false

# ====================================================================
# MEETING BOT INTEGRATION (MeetingBaaS)
# ====================================================================
MEETINGBAAS_API_KEY=your-meetingbaas-api-key-here
MEETINGBAAS_API_BASE_URL=https://api.meetingbaas.com
BOT_NAME=AI Meeting Assistant
BOT_ENTRY_MESSAGE=Hi, I'm an AI assistant here to take notes for this meeting.
SPEECH_TO_TEXT_PROVIDER=elevenlabs
# Direct asynchronous ElevenLabs batch STT (Supabase Edge secrets, never VITE_*).
ELEVENLABS_MODEL_ID=scribe_v2

# ====================================================================
# BACKEND SERVER CONFIGURATION (Express / Node.js)
# ====================================================================
PORT=5000
CORS_ORIGIN=http://localhost:5173
