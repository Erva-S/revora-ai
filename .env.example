# ====================================================================
# SUPABASE CONFIGURATION (Frontend & Database)
# ====================================================================
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ====================================================================
# AI INTELLIGENCE (Google Gemini API)
# ====================================================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ====================================================================
# MEETING BOT & TRANSCRIPTION (MeetingBaaS & ElevenLabs)
# ====================================================================
MEETINGBAAS_API_KEY=your-meetingbaas-api-key-here
BOT_NAME=AI Meeting Assistant
BOT_ENTRY_MESSAGE=Hi, I'm an AI assistant here to take notes for this meeting.
SPEECH_TO_TEXT_PROVIDER=elevenlabs
ELEVENLABS_MODEL_ID=scribe_v2

# ====================================================================
# BACKEND SERVER CONFIGURATION (Express / Node.js)
# ====================================================================
PORT=5000
VITE_API_URL=http://localhost:5000

# ====================================================================
# EMAIL DISPATCH CONFIGURATION (SMTP Protocol)
# ====================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password_here
SMTP_SECURE=false
SMTP_FROM="Revora AI Assistant" <your_email@gmail.com>
